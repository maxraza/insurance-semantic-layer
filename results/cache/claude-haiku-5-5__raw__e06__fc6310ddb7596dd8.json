   "input": {
    "query": "WITH x AS (\nSELECT p.written_premium wp, p.effective_date e, p.cover_end_date c, p.booked_date b, date_diff('day', p.effective_date, p.cover_end_date) len FROM premium_txn p\n), f AS (\nSELECT wp, len, b,\n CASE WHEN len=0 THEN 0 ELSE wp * LEAST(GREATEST(date_diff('day', e, DATE '2023-03-31')+1,0),len)*1.0/len END AS earned_q1_asat,\n CASE WHEN len=0 THEN 0 ELSE wp * LEAST(GREATEST(date_diff('day', e, DATE '2022-12-31')+1,0),len)*1.0/len END AS earned_dec22\nFROM x WHERE b <= DATE '2023-03-31'\n)\nSELECT SUM(CASE WHEN b<=DATE '2023-03-31' THEN earned_q1_asat END) cum_mar23,\n SUM(CASE WHEN b<=DATE '2022-12-31' THEN earned_dec22 END) cum_dec22,\n SUM(earned_q1_asat) - SUM(CASE WHEN b<=DATE '2022-12-31' THEN earned_dec22 END) earned_2023_q1,\n SUM(CASE WHEN len=0 THEN 1 ELSE 0 END) zero_len\nFROM f"
